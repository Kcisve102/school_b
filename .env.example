# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
DB_HOST=your-aws-rds-endpoint.amazonaws.com
DB_PORT=3306
DB_NAME=educational_video_platform
DB_USER=admin
DB_PASSWORD=your_secure_password

# Session Configuration
SESSION_SECRET=your_very_long_random_secret_key_here_change_this_in_production
SESSION_NAME=video_platform_session
SESSION_MAX_AGE=86400000

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=educational-videos-bucket
S3_VIDEO_PREFIX=videos/

# Google Gemini Configuration (for transcription and summarization)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration (Legacy - no longer used, can be removed)
# OPENAI_API_KEY=sk-your_openai_api_key
# WHISPER_MODEL=whisper-1
# GPT_MODEL=gpt-4-turbo-preview

# File Upload Configuration
MAX_FILE_SIZE=2147483648
ALLOWED_VIDEO_TYPES=video/mp4,video/mpeg,video/quicktime,video/x-msvideo,video/webm
UPLOAD_DIR=./uploads

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Lifetime of presigned S3 playback URLs, in seconds (default 12h, AWS max 7d).
S3_URL_EXPIRY_SECONDS=43200
FFMPEG_OUTPUT_QUALITY=medium
FFMPEG_TARGET_BITRATE=1000k

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Number of reverse-proxy hops in front of the app (Caddy alone = 1).
# Must match the deployment, or IP-based rate limiting can be spoofed.
TRUST_PROXY_HOPS=1

# ---- Freelancer.com OAuth integration ----
# App registered at https://accounts.freelancer.com/settings/develop
FLN_CLIENT_ID=
FLN_CLIENT_SECRET=
# Must EXACTLY match the Redirect URI registered on the app.
# Local dev: http://localhost:5173/auth (Vite proxies /auth to this backend).
# Production: https://www.knowverd.com/auth
# Must EXACTLY match one of the Redirect URIs registered on the Freelancer app.
FLN_REDIRECT_URI=http://localhost:5173/auth
FLN_SCOPES=basic
# Advanced scopes: SPACE-separated numeric ids, e.g. "1 2 3 4 5 6".
# Not scope names — Freelancer's own SDK example passes bare integers, and the
# ids for the scopes granted are shown on the app's page in the developer
# portal. Leave empty until the app is approved; an unapproved id is rejected.
FLN_ADVANCED_SCOPES=
FLN_AUTH_URL=https://accounts.freelancer.com/oauth/authorise
FLN_TOKEN_URL=https://accounts.freelancer.com/oauth/token
FLN_API_BASE=https://www.freelancer.com

# AES-256-GCM key for third-party OAuth tokens at rest.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
